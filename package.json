{
  "name": "heatmaster",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "types": "tsc --noEmit && pnpm -r --workspace-concurrency=1 exec tsc --noEmit",
    "test": "vitest run",
    "check": "FC_PROFILE=ci bash -c 'pnpm lint && pnpm types && pnpm test'",
    "build": "pnpm --filter @heatmaster/web build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}

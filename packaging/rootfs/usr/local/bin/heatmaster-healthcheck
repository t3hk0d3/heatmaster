#!/bin/bash
# Unhealthy only when the server does not answer, or still answers not_ready after the start
# period (a wedged start). Every MQTT fault keeps the container healthy: a broker that is down or
# refuses the login is retried by the server itself, and an instance that another instance took
# over (another_instance) is stopped for good until a person restarts it. A watchdog restart
# would let it take the broker session back, write the valves again and ping-pong with the other
# instance. /api/health still answers 503 with the reason, and the page says so.
port="${HEATMASTER_PORT:-3000}"
answer=$(curl -sS --max-time 5 -w '\n%{http_code}' "http://127.0.0.1:${port}/api/health") || exit 1
code="${answer##*$'\n'}"
body="${answer%$'\n'*}"
[ "$code" = "200" ] && exit 0
if [ "$code" = "503" ]; then
  [ "$(jq -r '.code // empty' <<<"$body" 2>/dev/null)" = "mqtt_fault" ] && exit 0
fi
exit 1
